{
  "name": "rostering",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && pnpm --filter @rostering/db seed",
    "db:generate": "pnpm --filter @rostering/db db:generate",
    "db:seed": "pnpm --filter @rostering/db seed"
  },
  "packageManager": "pnpm@10.28.2",
  "devDependencies": {
    "supabase": "^2.121.0",
    "turbo": "^2.11.9"
  }
}
